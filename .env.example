DEEPSEEK_API_KEY=your_deepseek_key
MINIMAX_API_KEY=your_minimax_key
DEEPSEEK_MODEL=deepseek-flash
MINIMAX_MODEL=speech-2.8-turbo
PORT=5173
MINIMAX_IMAGE_MODEL=image-01
# Optional: exact private proxy origins, comma-separated; no wildcards.
ALLOWED_ORIGINS=

# Speech provider: minimax (default) or qwen3 (local CustomVoice Demo).
TTS_PROVIDER=minimax
QWEN_TTS_URL=http://127.0.0.1:8000
# Model to load for automatic startup; must match an already running Demo.
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Set the installed Qwen project directory to start its .venv Demo with Lexi.
# Linux / WSL example: /mnt/e/ai/qwen3-tts; leave blank for a separately managed Demo.
QWEN_TTS_DIR=
QWEN_TTS_DEVICE=cuda:0
QWEN_TTS_DTYPE=bfloat16
# Model cache defaults to QWEN_TTS_DIR/models/huggingface.
QWEN_TTS_HF_HOME=
# Use pre-downloaded models without network checks; set 0 to allow downloads.
QWEN_TTS_OFFLINE=1
# Seconds to wait for model loading (10-3600).
QWEN_TTS_START_TIMEOUT=600
